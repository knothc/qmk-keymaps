
# Enable core split keyboard functionality
SPLIT_KEYBOARD = yes

# Enable OLED displays
OLED_DRIVER_ENABLE = yes

# Disable encoders as per original config
ENCODER_ENABLE = no

# Enable per-key RGB Matrix lighting (correct for rev4)
# The Kyria rev3 used RGBLIGHT for underglow, but the rev4 uses RGB_MATRIX for per-key lighting.
RGB_MATRIX_ENABLE = yes

# Other enabled features from the original config
COMBO_ENABLE = yes
COMMAND_ENABLE = no
CAPS_WORD_ENABLE = yes

